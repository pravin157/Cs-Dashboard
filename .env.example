# AECAutopilot base URL (the CS_V2_* eventTypes live on POST /customer-success)
AECAUTOPILOT_ENDPOINT=https://aecautopilot.intoaec.ai
# Server-side API key for AECAutopilot. Required - there is no built-in fallback.
AECAUTOPILOT_APIKEY=
# Port for the local server
PORT=3100
# Set to "true" to serve clearly-labelled sample data instead of calling the API
# (for UI development before the backend changes are deployed).
CS_V2_DEMO=false
